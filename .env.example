# Database
# Required for storing application data in Aurora Postgres
DATABASE_URL="postgresql://username:password@host:port/dbname"

# AI
# Required for Gemini AI API calls. To support round-robin key rotation to avoid rate limits,
# you can specify additional keys as GEMINI_API_KEY_2, GEMINI_API_KEY_3, etc.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_API_KEY_2="your_second_gemini_api_key_here"
GEMINI_API_KEY_3="your_third_gemini_api_key_here"

# FX Rates
# Optional: API key for exchangerate.host (if not provided, falls back to open.er-api.com)
EXCHANGERATE_HOST_API_KEY="your_exchangerate_host_api_key_here"

# Auth
# Required for NextAuth session encryption
NEXTAUTH_SECRET="any_random_32_character_string"
# NEXTAUTH_URL is auto-detected on Vercel via VERCEL_URL.
# Only set this for local development or custom domains.
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Stripe (Optional — only needed if using Stripe connector)
# Used for fetching bank transactions
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# QuickBooks Sandbox (Optional — only needed if using QBO connector)
# Used for OAuth flow and fetching ledger entries
QBO_CLIENT_ID="your_qbo_client_id_here"
QBO_CLIENT_SECRET="your_qbo_client_secret_here"
QBO_REALM_ID="your_qbo_realm_id_here"
QBO_ENVIRONMENT="sandbox"

# Vercel Cron (Optional — protects the /api/cron/* endpoints)
# Set this to a random string and add it to your Vercel environment variables.
# Vercel Pro plan sends this automatically; for Hobby, use an external cron service
# that includes this as a Bearer token in the Authorization header.
CRON_SECRET="your_random_cron_secret_here"

