# Database
# Required for storing application data in Aurora Postgres
DATABASE_URL="postgresql://username:password@host:port/dbname"

# AI
# Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# Auth
# Required for NextAuth session encryption
NEXTAUTH_SECRET="any_random_32_character_string"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Stripe Test Keys
# Used for fetching bank transactions
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# QuickBooks Sandbox
# Used for OAuth flow and fetching ledger entries
QBO_CLIENT_ID="your_qbo_client_id_here"
QBO_CLIENT_SECRET="your_qbo_client_secret_here"
QBO_REALM_ID="your_qbo_realm_id_here"
QBO_ENVIRONMENT="sandbox"
