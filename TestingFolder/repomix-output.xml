    );
    console.log(
        "MATCH EVALUATION"
    );
    console.log(
        "=====================================\n"
    );

    const metrics =
        evaluate(
            generatedMatches,
            expectedMatches
        );
    const generatedSet =
        new Set(
            generatedMatches.map(
                (m) =>
                    `${m.bankTransactionIds.join(",")}:${m.bookTransactionIds.join(",")}`
            )
        );

    const missedMatches =
        expectedMatches.filter(
            (m) =>
                !generatedSet.has(
                    `${m.bank_transaction_ids}:${m.book_transaction_ids}`
                )
        );

    console.log(
