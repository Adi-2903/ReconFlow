                    bank_transaction_ids:
                        row.bank_transaction_ids,
                    book_transaction_ids:
                        row.book_transaction_ids,
                    expected_confidence:
                        row.expected_confidence,
                    explanation:
                        row.explanation
                });
            })
            .on("end", () => resolve(results))
            .on("error", reject);
    });
}

