            )
            .slice(
                0,
                20
            )
    );

    const expectedSet =
        new Set(
            expectedMatches.map(
                (m) =>
                    `${m.bank_transaction_ids}:${m.book_transaction_ids}`
            )
        );

    const falsePositives =
        generatedMatches.filter(
